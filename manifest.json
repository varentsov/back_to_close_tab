{
  "manifest_version": 3,
  "name": "Back to Close Tab",
  "short_name": "Back to Close",
  "version": "1.0.0",
  "description": "Pressing Back with no back history left closes the tab instead of doing nothing.",
  "minimum_chrome_version": "102",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "back-or-close": {
      "description": "Go back, or close the tab when there is no back history"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
